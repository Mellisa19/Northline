# Northline backend configuration.
#
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is listed in .gitignore and must never be committed. Committing this
# example file is fine: it contains placeholders, not credentials.
#
# Every value can also be supplied as a real environment variable, which is what
# a deployed container should do. The real environment always wins over `.env`.

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Demonstration access
# ---------------------------------------------------------------------------
# Northline ships with a generated portfolio and a shared set of logins so a
# visitor can walk straight in: admin@northline.ng / northline2026, one account per
# role. The sign-in page lists them.
#
# That is the point of a demonstration, and the wrong thing for a deployment
# holding real borrower data. Set this to false and:
#   - no demo accounts are created
#   - /api/auth/demo returns 404
#   - the sign-in page offers only Google and email sign-up
DEMO_MODE=true

# ---------------------------------------------------------------------------
# Google sign-in
# ---------------------------------------------------------------------------
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorised JavaScript origin:  the value of APP_BASE_URL below
#   Authorised redirect URI:       the value of GOOGLE_REDIRECT_URI below
#
# Secrets are issued once. Paste them here and nowhere else — not into the
# frontend, not into the source, not into a chat.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Where the application lives
# ---------------------------------------------------------------------------
# The public origin people type into a browser. Local development uses the Vite
# dev server; production uses your real domain, for example
# https://northline.yourdomain.com
APP_BASE_URL=http://localhost:5180

# Where Google sends the browser back to. It must match the redirect URI in the
# Google Cloud console character for character, including the scheme and any
# trailing slash. If you leave this blank it defaults to
# APP_BASE_URL + /api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5180/api/auth/google/callback

# ---------------------------------------------------------------------------
# Browser origins allowed to call the API
# ---------------------------------------------------------------------------
# Comma-separated. Leave blank for local development.
#
# If your deployment serves the built interface from the same origin as the API —
# which is what `npm run build` plus a static mount gives you — you do not need
# this at all, and CORS never comes into play.
#
# If the interface lives on a different host to the API, list its origin here,
# for example: https://northline.yourdomain.com
ALLOWED_ORIGINS=
